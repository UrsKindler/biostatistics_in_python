from pathlib import Path
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from venny4py.venny4py import venny4py


sample_sets = {
    "Sample_01": {"Protein_A", "Protein_B", "Protein_C", "Protein_D"},
    "Sample_02": {"Protein_B", "Protein_C", "Protein_E"},
    "Sample_03": {"Protein_A", "Protein_C", "Protein_F"},
    "Sample_04": {"Protein_B", "Protein_D", "Protein_G"},
}


def main() -> None:
    output_dir = Path("venn_4_samples")
    output_dir.mkdir(exist_ok=True)

    venny4py(
        sets=sample_sets,
        out=str(output_dir),
        ext="png",
        dpi=300,
    )

    plt.close("all")

    print(
        "Venn-Diagramm erstellt. "
        f"Ausgabeordner: {output_dir.resolve()}"
    )


if __name__ == "__main__":
    main()

